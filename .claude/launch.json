{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "clinicos-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "clinicos-frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "clinicos-frontend-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "clinicos-frontend", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "env": { "VITE_API_URL": "http://localhost:3000" },
      "port": 5174
    }
  ]
}
