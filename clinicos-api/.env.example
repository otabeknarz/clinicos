# ClinicOS backend — muhit sozlamalari
#
# Nusxalang: cp .env.example .env

# --- Baza ---
# docker-compose.yml dagi bazaga mos keladi (port 5433)
DATABASE_URL="postgresql://clinicos:clinicos_dev@localhost:5433/clinicos?schema=public"

# --- Token ---
# ISHLAB CHIQARISHDA ALBATTA O'ZGARTIRING.
# Tasodifiy qiymat yaratish: openssl rand -base64 48
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="12h"

# --- Server ---
PORT=3000
# Frontend qaysi manzildan so'rov yuboradi.
#
# Vergul bilan bir nechta yozish mumkin. Vite 5173 band bo'lsa
# keyingi portga o'tadi, shuning uchun ishlab chiqishda bir
# nechtasi ochiq turadi.
#
# ISHLAB CHIQARISHDA faqat bitta haqiqiy manzil qoldiring.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"
